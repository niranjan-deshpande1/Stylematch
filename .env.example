DATABASE_URL=postgres://user:password@host/stylematch?sslmode=require
SESSION_SECRET=change-me

# AI
OPENAI_API_KEY=

# Image storage: any S3-compatible bucket (Neon Object Storage shown).
# Leave these blank to save uploads to ./uploads instead.
S3_ENDPOINT=https://<branch-id>.storage.<region>.aws.neon.tech
S3_REGION=us-east-2
S3_FORCE_PATH_STYLE=true
S3_BUCKET=uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Enables /admin when set
ADMIN_PASSWORD=
